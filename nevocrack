local neroStartAnimation
for _, v in pairs(getgc()) do
    if type(v) == "function" and islclosure(v) then
        local ok, info = pcall(debug.getinfo, v)
        if ok and info and info.name == "startAnimation" then neroStartAnimation = v break end
    end
end

local neroOldStartAnimation
if neroStartAnimation then
    neroOldStartAnimation = hookfunction(neroStartAnimation, function(p241, p242, p243, p244, p245)
        if neroOverrideArmed and (tick() - neroOverrideTime) <= NEVO_OVERRIDE_TTL then
            p242 = neroOverrideVel
            p243 = neroOverrideRot or Vector3.new(0, 0, 0)
            neroClearOverride()
        elseif neroOverrideArmed then
            neroClearOverride()
        end
        return neroOldStartAnimation(p241, p242, p243, p244, p245)
    end)
end

local neroOldNamecall
neroOldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    if getgenv().NeroConfig.enabled and neroStartAnimation and typeof(self) == "Instance"
        and self.Name == "KickBall" and method == "FireServer" then
        local args = {...}
        local ballPos, origVel = args[1], args[2]
        if typeof(ballPos) == "Vector3" and typeof(origVel) == "Vector3" then
            if neroIsNearWall(ballPos) and not neroState then
                local flatDir = Vector3.new(origVel.X, 0, origVel.Z)
                local forwardSpeed = flatDir.Magnitude
                flatDir = forwardSpeed > 0.01 and flatDir.Unit or Vector3.new(1, 0, 0)
                forwardSpeed = math.clamp(forwardSpeed, NEVO_CHIP_MIN, NEVO_CHIP_MAX)
                args[2] = flatDir * forwardSpeed + Vector3.new(0, neroChipVy(ballPos.Y), 0)
                args[3] = Vector3.new(0, 0, 0)
                neroArmOverride(args[2], args[3])
                neroState, neroChipTime = true, tick()
                task.delay(4, function() if neroState then neroState = false end end)
                return neroOldNamecall(self, unpack(args))
            elseif neroState then
                local shotVel, shotRot = neroComputeShot(ballPos)
                args[2], args[3] = shotVel, shotRot
                neroArmOverride(args[2], args[3])
                neroState = false
                return neroOldNamecall(self, unpack(args))
            end
        end
    end
    return neroOldNamecall(self, ...)
end)

