local function lobPowerLoop()
    if not lobCfg.enabled then return end
    local charNode = player.Character
    if not charNode then return end
    local hrp = charNode:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local ball = getBallDirect()
    if not ball or not ball.Parent then return end
    local ballPos = ball.Position
    local hrpPos = hrp.Position
    local dist = (ballPos - hrpPos).Magnitude
    if dist > lobCfg.reach + 2 then return end
    local lookVec = hrp.CFrame.LookVector
    local flatLook = Vector3.new(lookVec.X, 0, lookVec.Z)
    if flatLook.Magnitude < 0.01 then return end
    flatLook = flatLook.Unit
    local boost = (lobCfg.powerBoost or 12) * 1.5
    local curVel = ball.AssemblyLinearVelocity
    local targetH = boost * 3
    local targetY = math.max(curVel.Y, lobVyForLevel(lobCfg.heightLevel) * 0.6)
    pcall(function()
        ball.AssemblyLinearVelocity = Vector3.new(flatLook.X * targetH, targetY, flatLook.Z * targetH)
        ball.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
    end)
end

RunService.Heartbeat:Connect(function()
    pcall(lobPowerLoop)
end)

