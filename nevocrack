local EQUIP_TAG = "HairChangerEquipped"
local HAIR_ATTACHMENT_MAP = {
    HairBacon = "HairAttachment", HairBlack = "HairAttachment", HairBlackMask = "FaceFrontAttachment",
    HairBlonde = "HairAttachment", HairBrown = "HairAttachment", HairCap = "HatAttachment",
    HairCharmer = "HairAttachment", HairCool = "HairAttachment", HairDio = "HairAttachment",
    HairEgg = "HatAttachment", HairFloof = "HairAttachment", HairFluffed = "HairAttachment",
    HairGreen = "HairAttachment", HairHalloween = "FaceFrontAttachment", HairHat = "HatAttachment",
    HairHockeyMask = "FaceFrontAttachment", HairKnot = "HairAttachment", HairLongPink = "HairAttachment",
    HairMessy = "HairAttachment", HairNerd = "FaceFrontAttachment", HairBold = "HairAttachment",
}
local HAIR_OFFSET_TWEAKS = {
    HairBlackMask = CFrame.new(0.00, 0.00, -0.59), HairHockeyMask = CFrame.new(0.00, -0.01, -0.02),
    HairHalloween = CFrame.new(0.00, 0.05, -0.04), HairBrown = CFrame.new(0.00, 0.65, 0.00),
    HairCap = CFrame.new(0.00, 0.10, 0.30), HairCharmer = CFrame.new(0.00, 0.15, 0.05),
    HairGreen = CFrame.new(0.00, 0.20, -0.05), HairHat = CFrame.new(0.00, 0.10, -0.25),
    HairKnot = CFrame.new(0.00, 0.55, -0.05), HairNerd = CFrame.new(0.00, -0.65, -0.60),
}
local HAIR_ROTATION_TWEAKS = {
    HairHalloween = CFrame.Angles(math.rad(90), 0, 0),
}
local hairRelativeMap = {}

local function hairNukeAll(char)
    for _, obj in ipairs(char:GetChildren()) do
        if obj:GetAttribute(EQUIP_TAG) then obj:Destroy() end
    end
    for _, obj in ipairs(char:GetChildren()) do
        if obj.Name and typeof(obj.Name) == "string" and obj.Name:sub(1,4) == "Hair" and not obj:IsA("Attachment") then
            obj:Destroy()
        end
    end
    local head = char:FindFirstChild("Head")
    if head then
        for _, child in ipairs(head:GetChildren()) do
            if child:IsA("Weld") and (child.Name == "HairWeld" or child.Name == "SubWeld") then
                child:Destroy()
            end
        end
    end
    for _, desc in ipairs(char:GetDescendants()) do
        if desc:GetAttribute(EQUIP_TAG) then pcall(function() desc:Destroy() end) end
    end
end

local function hairGetHandle(clone)
    if clone:IsA("BasePart") then return clone end
    local function search(p, name)
        if p.Name == name and p:IsA("BasePart") then return p end
        for _, cc in ipairs(p:GetChildren()) do
            local f = search(cc, name)
            if f then return f end
        end
    end
    local h = search(clone, "Handle")
    if h then return h end
    if clone:IsA("Accessory") then
        for _, cc in ipairs(clone:GetChildren()) do if cc:IsA("BasePart") then return cc end end
    end
    if clone:IsA("Model") and clone.PrimaryPart then return clone.PrimaryPart end
    for _, d in ipairs(clone:GetDescendants()) do if d:IsA("MeshPart") then return d end end
    for _, d in ipairs(clone:GetDescendants()) do if d:IsA("UnionOperation") then return d end end
    for _, d in ipairs(clone:GetDescendants()) do if d:IsA("BasePart") then return d end end
end

local function hairGetAllParts(obj)
    local parts = {}
    if obj:IsA("BasePart") then table.insert(parts, obj) end
    for _, d in ipairs(obj:GetDescendants()) do
        if d:IsA("BasePart") then table.insert(parts, d) end
    end
    return parts
end

local function hairFindAttachment(obj)
    for _, cc in ipairs(obj:GetChildren()) do if cc:IsA("Attachment") then return cc end end
    for _, d in ipairs(obj:GetDescendants()) do if d:IsA("Attachment") then return d end end
end

local function removeHair()
    local char = player.Character
    if char then hairNukeAll(char) end
    HairConfig.currentHairId = nil
end

local function equipHair(hairId)
    if hairId == "DEFAULT" or hairId == nil then
        removeHair()
        return
    end
    local char = player.Character
    if not char then return end
    local head = char:FindFirstChild("Head")
    if not head then return end
    hairNukeAll(char)
    local src = ReplicatedStorage:FindFirstChild(hairId)
    if not src then return end
    local clone = src:Clone()
    local handle = hairGetHandle(clone)
    if not handle then clone:Destroy() return end
    local allParts = hairGetAllParts(clone)
    hairRelativeMap = {}
    for _, part in ipairs(allParts) do
        if part ~= handle then
            hairRelativeMap[part] = handle.CFrame:ToObjectSpace(part.CFrame)
        end
    end
    local att = hairFindAttachment(handle)
    local handleAttachCF = att and att.CFrame or CFrame.new()
    local headAttachName = HAIR_ATTACHMENT_MAP[hairId] or "HairAttachment"
    local headAttachment = head:FindFirstChild(headAttachName)
        or head:FindFirstChild("HairAttachment")
        or head:FindFirstChild("HatAttachment")
        or head:FindFirstChild("FaceFrontAttachment")
    if not headAttachment then clone:Destroy() return end
    for _, part in ipairs(allParts) do
        part.Anchored = false
        part.CanCollide = false
        part.Massless = true
    end
    for _, desc in ipairs(clone:GetDescendants()) do
        if desc:IsA("Weld") or desc:IsA("WeldConstraint") or desc:IsA("Motor6D") then
            desc:Destroy()
        end
    end
    local extraOffset = HAIR_OFFSET_TWEAKS[hairId] or CFrame.new()
    local extraRotation = HAIR_ROTATION_TWEAKS[hairId] or CFrame.new()
    local finalC1 = handleAttachCF * extraOffset * extraRotation
    handle.CFrame = head.CFrame * headAttachment.CFrame * finalC1:Inverse()
    for part, relCF in pairs(hairRelativeMap) do
        part.CFrame = handle.CFrame * relCF
    end
    local mw = Instance.new("Weld")
    mw.Name = "HairWeld"
    mw.Part0 = head
    mw.Part1 = handle
    mw.C0 = headAttachment.CFrame
    mw.C1 = finalC1
    mw.Parent = head
    for part, relCF in pairs(hairRelativeMap) do
        local sw = Instance.new("Weld")
        sw.Name = "SubWeld"
        sw.Part0 = handle
        sw.Part1 = part
        sw.C0 = relCF
        sw.C1 = CFrame.new()
        sw.Parent = handle
    end
    clone:SetAttribute(EQUIP_TAG, true)
    clone.Parent = char
    task.defer(function()
        for _, d in ipairs(clone:GetDescendants()) do
            if d:IsA("Weld") and d.Name == "AccessoryWeld" then d:Destroy() end
        end
        for _, part in ipairs(hairGetAllParts(clone)) do
            part.Anchored = false
            part.CanCollide = false
        end
    end)
    HairConfig.currentHairId = hairId
end

