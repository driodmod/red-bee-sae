local NEVO_GRAVITY = 55
local NEVO_GROUND_Y = 5.473
local NEVO_FLOOR_BUF = 6.2
local NEVO_GOAL_X_A = -313.13
local NEVO_GOAL_X_B = -115.936
local NEVO_POST_L_Z = 78.036
local NEVO_POST_R_Z = 107.715
local NEVO_BAR_Y = 18
local NEVO_FRAME_R = 1.825
local NEVO_BALL_R = 1.0
local NEVO_CLEAR = NEVO_FRAME_R + NEVO_BALL_R + 0.6
local NEVO_CENTER_Z = (NEVO_POST_L_Z + NEVO_POST_R_Z) / 2
local NEVO_CHIP_APEX = 16
local NEVO_CHIP_VY_MAX = 34
local NEVO_CHIP_MIN = 52
local NEVO_CHIP_MAX = 62
local NEVO_WALL_DIST = 10
local NEVO_SHOT_FWD_MIN = 60
local NEVO_SHOT_FWD_MAX = 95
local NEVO_APEX_CAP = NEVO_BAR_Y - NEVO_CLEAR - 0.2
local NEVO_OVERRIDE_TTL = 0.4

local neroState = false
local neroChipTime = 0
local neroOverrideArmed, neroOverrideVel, neroOverrideRot = false, nil, nil
local neroOverrideTime = 0

local function neroClearOverride()
    neroOverrideArmed, neroOverrideVel, neroOverrideRot = false, nil, nil
end

local function neroArmOverride(vel, rot)
    neroOverrideVel, neroOverrideRot = vel, rot or Vector3.new(0, 0, 0)
    neroOverrideArmed, neroOverrideTime = true, tick()
end

local function neroIsNearWall(pos)
    if pos.Y > 12 then return false end
    local distZ1 = math.abs(pos.Z - 23.443)
    local distZ2 = math.abs(pos.Z - 161.748)
    local distX1 = math.abs(pos.X - NEVO_GOAL_X_A)
    local distX2 = math.abs(pos.X - NEVO_GOAL_X_B)
    if distZ1 < NEVO_WALL_DIST or distZ2 < NEVO_WALL_DIST then return true end
    if (distX1 < NEVO_WALL_DIST or distX2 < NEVO_WALL_DIST) and not (pos.Z >= 70 and pos.Z <= 114) then
        return true
    end
    return false
end

local function neroChipVy(ballY)
    local rise = NEVO_CHIP_APEX - ballY
    if rise <= 1 then rise = 1 end
    return math.min(math.sqrt(2 * NEVO_GRAVITY * rise), NEVO_CHIP_VY_MAX)
end

local function neroSimGoal(pos, vel, goalX)
    local x0, y0, z0 = pos.X, pos.Y, pos.Z
    local vx, vy, vz = vel.X, vel.Y, vel.Z
    local dt = 0.004
    local px = x0
    for i = 1, 700 do
        local t = i * dt
        local x = x0 + vx * t
        local y = y0 + vy * t - 0.5 * NEVO_GRAVITY * t * t
        local z = z0 + vz * t
        if t > 0.06 and y < NEVO_FLOOR_BUF then return false end
        if math.abs(x - goalX) < 4 and z >= NEVO_POST_L_Z - 2 and z <= NEVO_POST_R_Z + 2 then
            local dbar = math.sqrt((x - goalX)^2 + (y - NEVO_BAR_Y)^2)
            if dbar < NEVO_FRAME_R + NEVO_BALL_R then return false end
        end
        if math.abs(x - goalX) < 4 and y >= -1.5 and y <= 19.5 then
            local dL = math.sqrt((x - goalX)^2 + (z - NEVO_POST_L_Z)^2)
            local dR = math.sqrt((x - goalX)^2 + (z - NEVO_POST_R_Z)^2)
            if dL < NEVO_FRAME_R + NEVO_BALL_R or dR < NEVO_FRAME_R + NEVO_BALL_R then return false end
        end
        local crossed = (goalX < -200 and x <= goalX and px > goalX) or (goalX > -200 and x >= goalX and px < goalX)
        if crossed then
            return (z >= NEVO_POST_L_Z + NEVO_CLEAR and z <= NEVO_POST_R_Z - NEVO_CLEAR and y >= NEVO_BALL_R and y <= NEVO_BAR_Y - NEVO_CLEAR)
        end
        px = x
    end
    return false
end

local function neroSolveShot(ballPos, targetX, targetZ, targetY, vy)
    local flat = Vector3.new(targetX - ballPos.X, 0, targetZ - ballPos.Z)
    local flatDist = flat.Magnitude
    local flatDir
    if flatDist < 1 then
        flatDir, flatDist = Vector3.new(targetX < -200 and -1 or 1, 0, 0), 1
    else
        flatDir = flat.Unit
    end
    local a = -0.5 * NEVO_GRAVITY
    local disc = vy * vy - 4 * a * (ballPos.Y - targetY)
    if disc < 0 then return nil end
    local sq = math.sqrt(disc)
    local t = math.max((-vy + sq) / (2 * a), (-vy - sq) / (2 * a))
    if t <= 0 then return nil end
    local fwd = flatDist / t
    if fwd < NEVO_SHOT_FWD_MIN or fwd > NEVO_SHOT_FWD_MAX then return nil end
    return flatDir * fwd + Vector3.new(0, vy, 0)
end

local function neroComputeShot(ballPos)
    local dA = math.abs(ballPos.X - NEVO_GOAL_X_A)
    local dB = math.abs(ballPos.X - NEVO_GOAL_X_B)
    local goalX = dA < dB and NEVO_GOAL_X_A or NEVO_GOAL_X_B
    local aimX = goalX + (goalX < -200 and -3 or 3)
    local vyMax = math.min(math.sqrt(math.max(2 * NEVO_GRAVITY * (NEVO_APEX_CAP - ballPos.Y), 1)), 33)
    for _, tY in ipairs({15, 14, 13, 12, 11, 10, 9}) do
        for vy = vyMax, 22, -1.5 do
            for _, zOff in ipairs({0, 5, -5, 8, -8, 3, -3}) do
                local tZ = math.clamp(NEVO_CENTER_Z + zOff, NEVO_POST_L_Z + NEVO_CLEAR + 1, NEVO_POST_R_Z - NEVO_CLEAR - 1)
                local vel = neroSolveShot(ballPos, aimX, tZ, tY, vy)
                if vel and neroSimGoal(ballPos, vel, goalX) then
                    return vel, Vector3.new(0, 0, 0)
                end
            end
        end
    end
    for _, tY in ipairs({13, 11, 9}) do
        for vy = 32, 20, -1 do
            local flat = Vector3.new(aimX - ballPos.X, 0, NEVO_CENTER_Z - ballPos.Z)
            local fdist = math.max(flat.Magnitude, 1)
            local fdir = flat.Magnitude > 0.01 and flat.Unit or Vector3.new(goalX < -200 and -1 or 1, 0, 0)
            local a = -0.5 * NEVO_GRAVITY
            local disc = vy * vy - 4 * a * (ballPos.Y - tY)
            if disc >= 0 then
                local t = (-vy - math.sqrt(disc)) / (2 * a)
                if t > 0 then
                    local vel = fdir * (fdist / t) + Vector3.new(0, vy, 0)
                    if neroSimGoal(ballPos, vel, goalX) then
                        return vel, Vector3.new(0, 0, 0)
                    end
                end
            end
        end
    end
    local flat = Vector3.new(aimX - ballPos.X, 0, NEVO_CENTER_Z - ballPos.Z)
    local fdir = flat.Magnitude > 0.01 and flat.Unit or Vector3.new(goalX < -200 and -1 or 1, 0, 0)
    return fdir * math.clamp(math.max(flat.Magnitude, 1) / 0.9, NEVO_SHOT_FWD_MIN, NEVO_SHOT_FWD_MAX) + Vector3.new(0, 30, 0), Vector3.new(0, 0, 0)
end

