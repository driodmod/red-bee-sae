local function SetAutoNero(state, force)
    state = state and true or false
    if getgenv().NeroConfig.enabled == state and not force then return end
    getgenv().NeroConfig.enabled = state
    if not state then
        neroState = false
        neroClearOverride()
    end
    neroUpdateButton()
    if AutoNeroToggleUI and not syncingUI then
        syncingUI = true
        pcall(function() AutoNeroToggleUI:Set(state) end)
        syncingUI = false
    end
end

