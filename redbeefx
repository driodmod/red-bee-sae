        return
    end

    if equippedGun.Name ~= GUN_TOOL_NAME then
        return
    end

    --==================================================*
    -- GHOSTSCOPE
    --==================================================*

    if CURRENT_STYLE == "GhostScope" then

        if object:IsA("BasePart") then

            saveGunOriginal(
                object,
                "Color"
            )

            saveGunOriginal(
                object,
                "Transparency"
            )

            object.Color = WHITE
            object.Transparency = 0.5

            if object:IsA("MeshPart") then

                saveGunOriginal(
                    object,
                    "TextureID"
                )

                object.TextureID = ""

            end

        elseif object:IsA("SpecialMesh") then

            saveGunOriginal(
                object,
                "TextureId"
            )

            object.TextureId = ""

            local parent =
                object.Parent

            if parent
                and parent:IsA("BasePart") then

                saveGunOriginal(
                    parent,
                    "Color"
                )

                saveGunOriginal(
                    parent,
                    "Transparency"
                )

                parent.Color = WHITE
                parent.Transparency = 0.5

            end

        elseif object:IsA("Decal")
            or object:IsA("Texture") then

            saveGunOriginal(
                object,
                "Transparency"
            )

            object.Transparency = 1

        elseif object:IsA("Beam")
            or object:IsA("Trail") then

            saveGunOriginal(
                object,
                "Color"
            )

            saveGunOriginal(
                object,
                "Transparency"
            )

            object.Color =
                ColorSequence.new(
                    WHITE
                )

            object.Transparency =
                NumberSequence.new(
                    0.5
                )

        end

        return

    end

    --==================================================*
    -- OTHER STYLES
    --==================================================*

    if object:IsA("MeshPart") then

        saveGunOriginal(
            object,
            "TextureID"
        )

        object.TextureID =
            TEXTURE_ID

    elseif object:IsA("SpecialMesh") then

        saveGunOriginal(
            object,
            "TextureId"
        )

        object.TextureId =
            TEXTURE_ID

    elseif object:IsA("Decal")
        or object:IsA("Texture") then

        saveGunOriginal(
            object,
            "Texture"
        )

        object.Texture =
            TEXTURE_ID

    elseif object:IsA("Beam")
        or object:IsA("Trail") then

        applyEffectColor(object)

    end

end

--==================================================*
-- APPLY STYLE TO GUN
--==================================================*

local function applyStyleToGun(tool)

    if not tool then
        return
    end

    if not tool:IsA("Tool") then
        return
    end

    if tool.Name ~= GUN_TOOL_NAME then
        return
    end

    equippedGun = tool

    local textures = 0
    local effects = 0

    for _, object in ipairs(
        tool:GetDescendants()
    ) do

        if CURRENT_STYLE == "GhostScope" then

            if object:IsA("BasePart")
                or object:IsA("SpecialMesh")
                or object:IsA("Decal")
                or object:IsA("Texture") then

                changeGunObject(object)
                textures += 1

            elseif object:IsA("Beam")
                or object:IsA("Trail") then

                changeGunObject(object)
                effects += 1

            end

        elseif object:IsA("MeshPart")
            or object:IsA("SpecialMesh")
            or object:IsA("Decal")
            or object:IsA("Texture") then

            changeGunObject(object)
            textures += 1

        elseif object:IsA("Beam")
            or object:IsA("Trail") then

            applyEffectColor(object)
            effects += 1

        end

    end

    status.Text =
        CURRENT_STYLE
        .. " applied • "
        .. textures
        .. " textures • "
        .. effects
        .. " effects"

end

--==================================================*
-- RESTORE GUN
--==================================================*

local function restoreGun(tool)

    if not tool then
        return
    end

    for object, properties in pairs(
        originalGunProperties
    ) do

        if object and object.Parent then

            for property, originalValue
                in pairs(properties) do

                pcall(
                    function()

                        object[property] =
                            originalValue

                    end
                )

            end

        end

    end

    originalGunProperties = {}

    if equippedGun == tool then
        equippedGun = nil
    end

end

--==================================================*
-- RESTORE DISPLAY
--==================================================*

local function restoreDisplay()

    for object, properties in pairs(
        originalDisplayTextures
    ) do

        if object and object.Parent then

            for property, originalValue
                in pairs(properties) do

                pcall(
                    function()

                        object[property] =
                            originalValue

                    end
                )

            end

        end

    end

    originalDisplayTextures = {}
    selectedGunDisplay = nil

end

