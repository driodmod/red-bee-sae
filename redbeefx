--==================================================*
-- OBJECT POSITION
--==================================================*

local function getObjectPosition(object)

    if object:IsA("BasePart") then
        return object.Position
    end

    if object:IsA("Model") then

        local part =
            object.PrimaryPart
            or object:FindFirstChildWhichIsA(
                "BasePart",
                true
            )

        if part then
            return part.Position
        end

    end

    if object:IsA("Tool") then

        local handle =
            object:FindFirstChild(
                "Handle",
                true
            )

        if handle and handle:IsA("BasePart") then
            return handle.Position
        end

    end

    return nil

end

--==================================================*
-- FIND NEAREST GUNDISPLAY
--==================================================*

local function findNearestGunDisplay()

    local character = player.Character

    local root =
        character
        and character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not root then
        return nil, nil, "Character isn't loaded."
    end

    local nearest = nil
    local nearestDistance = math.huge

    for _, object in ipairs(
        workspace:GetDescendants()
    ) do

        if object.Name == TARGET_NAME then

            local position =
                getObjectPosition(object)

            if position then

                local distance =
                    (position - root.Position).Magnitude

                if distance < nearestDistance then

                    nearestDistance = distance
                    nearest = object

                end

            end

        end

    end

    if not nearest then
        return nil, nil, "No GunDisplay found."
    end

    return nearest, nearestDistance

end

