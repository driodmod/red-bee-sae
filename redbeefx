--==================================================*
-- EFFECT COLOR
--==================================================*

local function applyEffectColor(object)

    if not object then
        return
    end

    if not (
        object:IsA("Beam")
        or object:IsA("Trail")
    ) then

        return

    end

    saveGunOriginal(
        object,
        "Color"
    )

    if CURRENT_STYLE == "GhostScope" then

        saveGunOriginal(
            object,
            "Transparency"
        )

        object.Color =
            ColorSequence.new(WHITE)

        object.Transparency =
            NumberSequence.new(0.5)

    elseif CURRENT_STYLE == "VoidScope" then

        object.Color =
            ColorSequence.new({

                ColorSequenceKeypoint.new(
                    0,
                    Color3.fromRGB(
                        255,
                        255,
                        255
                    )
                ),

                ColorSequenceKeypoint.new(
                    0.5,
                    Color3.fromRGB(
                        170,
                        170,
                        170
                    )
                ),

                ColorSequenceKeypoint.new(
                    1,
                    Color3.fromRGB(
                        0,
                        0,
                        0
                    )
                )

            })

    elseif BEAM_COLOR then

        object.Color =
            ColorSequence.new(
                BEAM_COLOR
            )

    end

end

