    end

    if originalDisplayTextures[object][property]
        == nil then

        originalDisplayTextures[object][property] =
            object[property]

    end

end

--==================================================*
-- CHANGE GUNDISPLAY
--==================================================*

local function changeDisplayTextures(root)

    if not root or not root.Parent then
        return 0
    end

    local changed = 0

    local function change(
        object,
        property,
        value
    )

        local success = pcall(
            function()

                saveDisplayOriginal(
                    object,
                    property
                )

                object[property] = value

            end
        )

        if success then
            changed += 1
        end

    end

    --==================================================*
    -- GHOSTSCOPE
    --==================================================*

    if CURRENT_STYLE == "GhostScope" then

        local function ghostObject(object)

            if object:IsA("BasePart") then

                change(
                    object,
                    "Color",
                    WHITE
                )

                change(
                    object,
                    "Transparency",
                    0.5
                )

                if object:IsA("MeshPart") then

                    change(
                        object,
                        "TextureID",
                        ""
                    )

                end

            elseif object:IsA("SpecialMesh") then

                change(
                    object,
                    "TextureId",
                    ""
                )

                local parent = object.Parent

                if parent
                    and parent:IsA("BasePart") then

                    change(
                        parent,
                        "Color",
                        WHITE
                    )

                    change(
                        parent,
                        "Transparency",
                        0.5
                    )

                end

            elseif object:IsA("Decal")
                or object:IsA("Texture") then

                change(
                    object,
                    "Transparency",
                    1
                )

            elseif object:IsA("Beam")
                or object:IsA("Trail") then

                change(
                    object,
                    "Color",
                    ColorSequence.new(WHITE)
                )

                change(
                    object,
                    "Transparency",
                    NumberSequence.new(0.5)
                )

            end

        end

        ghostObject(root)

        for _, object in ipairs(
            root:GetDescendants()
        ) do

            ghostObject(object)

        end

        return changed

    end

    --==================================================*
    -- NORMAL TEXTURE SCOPES
    --==================================================*

    if not TEXTURE_ID then
        return 0
    end

    local function changeTexture(object)

        if object:IsA("MeshPart") then

            change(
                object,
                "TextureID",
                TEXTURE_ID
            )

        elseif object:IsA("SpecialMesh") then

            change(
                object,
                "TextureId",
                TEXTURE_ID
            )

        elseif object:IsA("Decal")
            or object:IsA("Texture") then

            change(
                object,
                "Texture",
                TEXTURE_ID
            )

        end

    end

    changeTexture(root)

    for _, object in ipairs(
        root:GetDescendants()
    ) do

        changeTexture(object)

    end

    return changed

end

