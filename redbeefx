--==================================================*
-- SETUP TOOL
--==================================================*

local function setupTool(tool)

    if not tool:IsA("Tool") then
        return
    end

    if tool.Name ~= GUN_TOOL_NAME then
        return
    end

    if connectedTools[tool] then
        return
    end

    connectedTools[tool] = true
    toolEffectConnections[tool] = {}

    local function prepareEffect(object)

        if not (
            object:IsA("Beam")
            or object:IsA("Trail")
        ) then

            return

        end

        saveGunOriginal(
            object,
            "Color"
        )

        saveGunOriginal(
            object,
            "Transparency"
        )

        local connection =
            object:GetPropertyChangedSignal(
                "Color"
            ):Connect(
                function()

                    if equippedGun ~= tool then
                        return
                    end

                    if CURRENT_STYLE == "Normal" then
                        return
                    end

                    if not object.Parent then
                        return
                    end

                    if CURRENT_STYLE == "GhostScope" then

                        changeGunObject(
                            object
                        )

                    else

                        applyEffectColor(
                            object
                        )

                    end

                end
            )

        table.insert(
            toolEffectConnections[tool],
            connection
        )

        if equippedGun == tool
            and CURRENT_STYLE ~= "Normal" then

            changeGunObject(
                object
            )

        end

    end

    for _, object in ipairs(
        tool:GetDescendants()
    ) do

        prepareEffect(object)

    end

    gunDescendantConnections[tool] =
        tool.DescendantAdded:Connect(
            function(object)

                if object:IsA("Beam")
                    or object:IsA("Trail") then

                    prepareEffect(object)

                end

                if equippedGun == tool
                    and CURRENT_STYLE ~= "Normal" then

                    changeGunObject(
                        object
                    )

                end

            end
        )

    tool.Equipped:Connect(
        function()

            equippedGun = tool

            if CURRENT_STYLE ~= "Normal" then

                applyStyleToGun(
                    tool
                )

            else

                status.Text =
                    "Gun equipped • NORMAL"

            end

        end
    )

    tool.Unequipped:Connect(
        function()

            if CURRENT_STYLE == "GhostScope" then

                restoreGun(tool)

                status.Text =
                    "Gun unequipped • GhostScope remains on GunDisplay."

            else

                restoreGun(tool)

                status.Text =
                    "Gun unequipped • "
                    .. CURRENT_STYLE

            end

        end
    )

    tool.Destroying:Connect(
        function()

            connectedTools[tool] = nil

            if toolEffectConnections[tool] then

                for _, connection in ipairs(
                    toolEffectConnections[tool]
                ) do

                    connection:Disconnect()

                end

                toolEffectConnections[tool] = nil

            end

            if gunDescendantConnections[tool] then

                gunDescendantConnections[tool]:Disconnect()

                gunDescendantConnections[tool] = nil

            end

        end
    )

end

