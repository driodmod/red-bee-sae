--==================================================*
-- MOBILE BUTTON DRAGGING
--==================================================*

local mobileDragging = false
local mobileDragStart
local mobileStartPosition
local mobileMoved = false

mobileButton.InputBegan:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        mobileDragging = true
        mobileMoved = false
        mobileDragStart = input.Position
        mobileStartPosition = mobileButton.Position

    end

end)

UserInputService.InputChanged:Connect(function(input)

    if not mobileDragging then
        return
    end

    if input.UserInputType ~= Enum.UserInputType.MouseMovement
        and input.UserInputType ~= Enum.UserInputType.Touch then

        return

    end

    local delta =
        input.Position - mobileDragStart

    if math.abs(delta.X) > 5
        or math.abs(delta.Y) > 5 then

        mobileMoved = true

    end

    mobileButton.Position = UDim2.new(
        mobileStartPosition.X.Scale,
        mobileStartPosition.X.Offset + delta.X,
        mobileStartPosition.Y.Scale,
        mobileStartPosition.Y.Offset + delta.Y
    )

end)

UserInputService.InputEnded:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        if mobileDragging and not mobileMoved then
            toggleUI()
        end

        mobileDragging = false

    end

end)

