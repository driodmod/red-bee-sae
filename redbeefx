    end

    if not selectedStyle then
        return
    end

    local gunToReapply = equippedGun

    restoreDisplay()

    if equippedGun then
        restoreGun(equippedGun)
    end

    CURRENT_STYLE =
        selectedStyle.Name

    TEXTURE_ID =
        selectedStyle.Texture

    BEAM_COLOR =
        selectedStyle.Beam

    updateStyleUI()

    picker.Visible = false

    if CURRENT_STYLE == "Normal" then

        status.Text =
            "NORMAL • Original color restored."

        return

    end

    local target,
        distance,
        errorMessage =
        findNearestGunDisplay()

    if not target then

        status.Text =
            errorMessage

        return

    end

    selectedGunDisplay =
        target

    local changed =
        changeDisplayTextures(target)

    if changed == 0 then

        status.Text =
            "No editable GunDisplay objects found."

    else

        status.Text =
            CURRENT_STYLE
            .. " selected • "
            .. math.floor(distance)
            .. " studs"

    end

    if CURRENT_STYLE == "GhostScope"
        and gunToReapply
        and gunToReapply.Parent then

        applyStyleToGun(
            gunToReapply
        )

    end

end

