local function home()
    if PS then
        local ok, cf = pcall(function() return PS.FindRespawnCFrame() end)
        if ok and typeof(cf) == "CFrame" then return cf.Position end
    end
    local sl = Workspace:FindFirstChildOfClass("SpawnLocation")
    if sl and sl:IsA("BasePart") then return sl.Position end
    return Vector3.new(512, 68, -362)
end

local function deliver()
    if not heldEggUid then return end
    local uid = heldEggUid
    BX.arc(home(), K.CARRY_FLOOR, function() return heldEggUid == nil end)
    task.wait(3)
    local st
    pcall(function()
        local r = EggState.ReadFieldEgg(uid)
        st = r and r.State
    end)
    if st ~= "Carried" then
        RedBeeStealDone(nameOf({ AssetCategory = "egg" }))
        if selectedEggUid == uid then
            selectedEggUid = nil
        end
    else
        toast("Delivery failed")
    end
    heldEggUid = nil
end

local function carrying()
    local f
    pcall(function()
        local d = EggState.ReadFieldEggs and EggState.ReadFieldEggs()
        for _, r in pairs(d and d.Records or {}) do
            if r.State == "Carried" then f = r.Uid break end
        end
    end)
    return f
end

function startProtect()
    if protectThread then return end
    protectThread = task.spawn(function()
        while isProtecting do task.wait(K.PROTECT_INTERVAL) end
    end)
end

function stopProtect()
    isProtecting = false
    if protectThread then pcall(task.cancel, protectThread) protectThread = nil end
end

-- ================================================================
-- STEAL LOOP
-- ================================================================
local function stealLoop()
    pcall(function()
        if FieldCarryRE then
            FieldCarryRE.OnClientEvent:Connect(function(s)
                if typeof(s) == "table" and s.IsCarrying == false then
                    heldEggUid = nil
                    pcall(stopProtect)
                    isProtecting = false
                end
            end)
        end
    end)
    acOff()
    local idle = 0
    while stealing do
        R.Heartbeat:Wait()
        if not stealing then break end
        if idle >= 8 then
            idle = 0
            BX.cache = nil
            task.wait(4)
            continue
        end
        local h = getHRP()
        local hm = getHum()
        if not h or not hm or hm.Health <= 0 then task.wait(1) continue end
        if isRag() then unrag() task.wait(.1) end
        local have = carrying()
        if have then
            heldEggUid = heldEggUid or have
            deliver()
            continue
        end
        cachedEggs = evalEggs(true)
        if #cachedEggs == 0 then idle = idle + 1 task.wait(2) continue end
        for u, a in pairs(BX.unreachable) do
            if tick() - a > K.UNREACHABLE then BX.unreachable[u] = nil end
        end
        local target
        if selectedEggUid then
            for _, e in ipairs(cachedEggs) do
                if e.uid == selectedEggUid then
                    if e.grabbable then target = e end
                    break
                end
            end
        end
        if not target and BX.followBest then
            for _, e in ipairs(cachedEggs) do
                if e.grabbable and not BX.unreachable[e.uid] then target = e break end
            end
        end
        if not target then
            for _, e in ipairs(cachedEggs) do
                if e.grabbable then target = e break end
            end
        end
        if not target then idle = idle + 1 task.wait(2) continue end
        BX.arc(target.pos, K.ARC_SPEED)
        if not stealing then break end
        local isFirst = SlotId.LooksLikeFirstAreaUid(target.uid)
        local slot = isFirst and SlotId.SlotKey(target.rec.AreaId, target.rec.NestId) or nil
        if carry(target.uid, slot) then
            idle = 0
            stolenUids[target.uid] = tick()
            heldEggUid = target.uid
            heldEggSlotKey = slot
            isProtecting = true
            startProtect()
            task.wait(.4)
            deliver()
        else
            idle = idle + 1
            BX.unreachable[target.uid] = tick()
        end
        task.wait(stealDelay)
    end
end

