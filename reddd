local function fmt(n)
    n = tonumber(n) or 0
    for _, u in ipairs({{1e12,"T"},{1e9,"B"},{1e6,"M"},{1e3,"K"}}) do
        if n >= u[1] then
            local v = n / u[1]
            return ((v < 10) and string.format("%.2f", v) or
                string.format("%.1f", v)):gsub("%.?0+$", "") .. u[2]
        end
    end
    return tostring(math.round(n))
end

local function valOf(rec)
    if BX.valueCache[rec.Uid] then
        BX.valueCacheNext[rec.Uid] = BX.valueCache[rec.Uid]
        return BX.valueCache[rec.Uid]
    end
    local item = { Category = rec.AssetCategory, Scale = tonumber(rec.AssetScale) or 1,
        Mutations = rec.Mutations or {} }
    local function keep(v)
        v = tonumber(v) or 0
        BX.valueCache[rec.Uid] = v
        BX.valueCacheNext[rec.Uid] = v
        return v
    end
    if Earnings then
        local ok, r = pcall(Earnings.LiveRatePerSecond, item, nil, nil, LP)
        if ok and type(r) == "number" then return keep(r) end
        ok, r = pcall(Earnings.MutationOnlyRatePerSecond, item)
        if ok and type(r) == "number" then return keep(r) end
    end
    local d = AD and AD[rec.AssetCategory]
    if not d then return 0 end
    local base = tonumber(d.EarningRate) or 0
    local s = item.Scale
    local sf = s <= 5 and s ^ 1.85 or (s / 5) ^ 1.2 * 19.637875755794113
    local mm = 1
    pcall(function() mm = Mutations.EarningsFor(item.Mutations) end)
    return keep(math.max(1, math.round(base * sf * (tonumber(mm) or 1))))
end

local function nameOf(rec)
    local d = AD and AD[rec.AssetCategory]
    return d and d.DisplayName or rec.AssetCategory
end

local function rareOf(rec)
    local d = AD and AD[rec.AssetCategory]
    if d and d.Rarity then return d.Rarity.DisplayName or d.Rarity._id or "?" end
    return "?"
end

function BX.farmAny(s)
    for _ in pairs(s or {}) do return true end
    return false
end

function BX.farmWanted(rec)
    if not BX.farmActive then return true end
    if BX.farmAny(BX.farmAreas) and not BX.farmAreas[tostring(rec.AreaId)] then return false end
    if BX.farmAny(BX.farmRarities) and not BX.farmRarities[rareOf(rec)] then return false end
    return true
end

function BX.snap(force)
    local now = os.clock()
    if not force and BX.rawSnap and (now - (BX.rawAt or 0)) < K.EGG_TTL then
        return BX.rawSnap
    end
    local recs = {}
    pcall(function()
        local d = EggState.ReadFieldEggs and EggState.ReadFieldEggs()
        if type(d) == "table" and type(d.Records) == "table" then
            for _, r in ipairs(d.Records) do if r.Uid then recs[#recs+1] = r end end
        end
    end)
    if #recs > 0 then
        BX.rawSnap = { Records = recs }
        BX.rawAt = now
    end
    return BX.rawSnap
end

local function evalEggs(force)
    local now = os.clock()
    if not force and BX.cache and (now - (BX.cacheAt or 0)) < K.EGG_TTL then
        return BX.cache
    end
    local data = BX.snap(force)
    if not (data and data.Records) then
        BX.cache = BX.cache or {}
        BX.cacheAt = now
        return BX.cache
    end
    local nt = tick()
    for u, a in pairs(stolenUids) do if nt - a > 120 then stolenUids[u] = nil end end
    BX.valueCacheNext = {}
    local out = {}
    for _, rec in ipairs(data.Records) do
        local grab = rec.State == "Slot" or rec.State == "Dropped"
        local vis = grab or rec.State == "GuardCarried"
        if stolenUids[rec.Uid] and (rec.State == "Slot" or rec.State == "Dropped"
            or rec.State == "GuardCarried") then
            stolenUids[rec.Uid] = nil
        end
        local mine = false
        pcall(function() mine = SlotId.FirstAreaOwnerUserId(rec.Uid) == LP.UserId end)
        if vis and not mine and not stolenUids[rec.Uid] and BX.farmWanted(rec)
            and typeof(rec.BoundsCFrame) == "CFrame" then
            out[#out+1] = {
                uid = rec.Uid, grabbable = grab, dropped = rec.State == "Dropped",
                guardHeld = rec.State == "GuardCarried",
                name = nameOf(rec), area = rec.AreaId, rarity = rareOf(rec),
                value = valOf(rec), pos = rec.BoundsCFrame.Position, rec = rec,
            }
        end
    end
    table.sort(out, function(a, b) return a.value > b.value end)
    BX.valueCache = BX.valueCacheNext
    BX.valueCacheNext = {}
    BX.cache = out
    BX.cacheAt = os.clock()
    return out
end

