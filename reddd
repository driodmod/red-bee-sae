local function waitF(p, n, t)
    if not p then return nil end
    local ok, c = pcall(function() return p:WaitForChild(n, t or 15) end)
    return ok and c or nil
end
local function findD(root, n, t)
    if not root then return nil end
    local dl = os.clock() + (t or 15)
    repeat
        local f = root:FindFirstChild(n, true)
        if f then return f end
        task.wait(.2)
    until os.clock() > dl
    return nil
end
local function needM(root, ...)
    local n = root
    for _, x in ipairs({...}) do
        if not n then return nil end
        local ok, c = pcall(function() return n:WaitForChild(x, 20) end)
        n = ok and c or nil
    end
    if not n then return nil end
    local ok, m = pcall(require, n)
    return ok and m or nil
end

