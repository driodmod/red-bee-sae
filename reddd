-- ================================================================
-- TRACE
-- ================================================================
local TRACE = true
local TRACE_FILE = "RedBeeHub_trace.txt"
local traceBuf = {}
local traceAt = 0
local traceStart = os.clock()
local canWF = (typeof(writefile) == "function")
local function trace(msg)
    if not TRACE then return end
    local t = tostring(msg)
    if t == traceBuf.last then
        traceBuf.rep = (traceBuf.rep or 0) + 1
        return
    end
    traceBuf.last = t
    traceBuf.rep = 0
    local line = string.format("[%7.2fs] %s", os.clock() - traceStart, t)
    if (type(getgenv) == "function" and getgenv().RedBeeDebug) or _G.RedBeeDebug then
        print("[REDBEE] " .. line)
    end
    if not canWF then return end
    traceBuf[#traceBuf+1] = line
    if #traceBuf > 400 then table.remove(traceBuf, 1) end
    if line:find("===", 1, true) or (os.clock() - traceAt) >= 1 then
        traceAt = os.clock()
        pcall(writefile, TRACE_FILE, table.concat(traceBuf, "\n"))
    end
end
