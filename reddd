-- AUTO REFRESH
-- ================================================================
task.spawn(function()
    local lastCount, lastAt = nil, 0
    while true do
        task.wait(3)
        if env.__RBG ~= GEN then return end
        local n
        pcall(function()
            local d = EggState and EggState.ReadFieldEggs and EggState.ReadFieldEggs()
            local c = 0
            for _, rec in pairs(d and d.Records or {}) do
                if rec.State == "Slot" or rec.State == "Dropped" then c = c + 1 end
            end
            n = c
        end)
        if n then
            if lastCount == nil then lastCount = n
            elseif n ~= lastCount then
                local grew = n > lastCount
                lastCount = n
                if grew and (os.clock() - lastAt) > 15 then
                    lastAt = os.clock()
                    BX.cache = nil
                    trace(("refresh: field grew to %d"):format(n))
                    pcall(refresh, true)
                end
            end
        end
    end
end)

