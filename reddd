local pc, pa = nil, 0
local function firePrompt()
    if not fireproximityprompt then return false end
    local h = getHRP() if not h then return false end
    local now = os.clock()
    if not pc or now - pa > K.PROMPT_CACHE then
        local l = {}
        for _, d in ipairs(Workspace:GetDescendants()) do
            if d:IsA("ProximityPrompt") then
                local t = string.lower(tostring(d.ActionText) .. " "
                    .. tostring(d.ObjectText) .. " " .. d.Name)
                if t:find("steal") or t:find("carry") then l[#l+1] = d end
            end
        end
        pc, pa = l, now
    end
    local best, bd = nil, math.huge
    for _, d in ipairs(pc) do
        if d.Parent and d.Enabled then
            local par = d.Parent
            local p
            if par:IsA("BasePart") then p = par.Position
            elseif par:IsA("Model") then p = par:GetPivot().Position end
            if p then
                local dist = (h.Position - p).Magnitude
                if dist <= d.MaxActivationDistance + 8 and dist < bd then
                    best, bd = d, dist
                end
            end
        end
    end
    if not best then return false end
    pcall(function() best.HoldDuration = 0 best.RequiresLineOfSight = false end)
    return pcall(function()
        fireproximityprompt(best, 0)
        fireproximityprompt(best)
    end)
end

local function carry(uid, slot)
    pcall(BX.claimOwner)
    local got = false
    if EggState.CarryFieldEgg then
        local rp
        pcall(function()
            local r = EggState.ReadFieldEgg(uid)
            rp = r and r.BoundsCFrame and r.BoundsCFrame.Position
        end)
        local h = getHRP()
        if rp and h and (rp - h.Position).Magnitude <= 9 then
            local ok, res = pcall(function()
                return EggState.CarryFieldEgg(uid, slot)
            end)
            if ok and res == true then got = true end
        end
    end
    if not got then
        for _ = 1, K.GRAB_TRIES do
            if got then break end
            if firePrompt() then
                local t0 = os.clock()
                repeat
                    local st
                    pcall(function()
                        local r = EggState.ReadFieldEgg(uid)
                        st = r and r.State
                    end)
                    if st == "Carried" then got = true break end
                    task.wait()
                until os.clock() - t0 > K.GRAB_CONFIRM
            end
            task.wait(.03)
        end
    end
    return got
end

