function BX.claimOwner()
    local h = getHRP() if not h then return false end
    local n = os.clock()
    if n - (BX.ownAt or 0) < .5 then return BX.ownOk == true end
    BX.ownAt = n
    local ok = false
    pcall(function()
        if typeof(setnetworkowner) == "function" then
            setnetworkowner(h, true) ok = true
        end
    end)
    if not ok then
        pcall(function()
            if typeof(sethiddenproperty) == "function" then
                sethiddenproperty(h, "NetworkOwnershipAuto", false) ok = true
            end
        end)
    end
    BX.ownOk = ok
    if ok then BX.ownFail = 0
    else
        BX.ownFail = (BX.ownFail or 0) + 1
        if BX.ownFail == 3 then trace("ac: ownership claim failed 3x") end
    end
    return ok
end

