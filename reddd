local function isRag()
    local h = getHum() if not h then return false end
    if h.PlatformStand then return true end
    local s = h:GetState()
    return s == Enum.HumanoidStateType.Physics
        or s == Enum.HumanoidStateType.Ragdoll
        or s == Enum.HumanoidStateType.FallingDown
end
local function unrag()
    local h = getHum()
    if h then
        pcall(function()
            h.PlatformStand = false
            h.Sit = false
            h:ChangeState(Enum.HumanoidStateType.GettingUp)
        end)
    end
end

