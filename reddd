local UI = { MAX = 60, map = {}, suppress = false, refreshing = false, lastSig = nil }

local function eggLbl(e)
    local s = ""
    if e.guardHeld then s = "  (guard)" elseif e.dropped then s = "  (floor)" end
    return e.name .. "  |  " .. fmt(e.value) .. "/s" .. s
end

local function buildOpts()
    local o = {}
    UI.map = {}
    local used = {}
    for i, e in ipairs(cachedEggs) do
        if i > UI.MAX then break end
        local l = eggLbl(e)
        if used[l] then
            used[l] = used[l] + 1
            l = l .. ("  #%d"):format(used[l])
        else used[l] = 1 end
        UI.map[l] = e.uid
        o[#o+1] = l
    end
    if #o == 0 then o[1] = "No eggs found" end
    return o
end

local function findEgg(v)
    if type(v) ~= "string" or v == "" or v == "No eggs found" then return nil end
    local u = UI.map[v]
    if u then
        for _, e in ipairs(cachedEggs) do if e.uid == u then return e end end
        return { uid = u, name = v }
    end
    return nil
end

function UI.onDropdown(v)
    if UI.suppress then return end
    if typeof(v) == "table" then v = v[1] end
    local e = findEgg(v)
    if not e then return end
    selectedEggUid = e.uid
    toast("Target: " .. e.name)
end

eggDropdown = MainTab:CreateDropdown({
    name = "Target Egg",
    options = { "Loading..." },
    flag = "TargetEgg",
    callback = UI.onDropdown,
})

local function applyOpts(o)
    if not eggDropdown then return end
    local sig = table.concat(o, "")
    if sig == UI.lastSig then return end
    UI.lastSig = sig
    UI.suppress = true
    pcall(function() eggDropdown:Refresh(o) end)
    UI.suppress = false
end

local function showSel()
    if not eggDropdown then return end
    local l
    for _, e in ipairs(cachedEggs) do
        if e.uid == selectedEggUid then l = eggLbl(e) break end
    end
    if not l and cachedEggs[1] then
        selectedEggUid = cachedEggs[1].uid
        l = eggLbl(cachedEggs[1])
    end
    l = l or "No eggs found"
    UI.suppress = true
    pcall(function() eggDropdown:Set(l, true) end)
    UI.suppress = false
end

local function refresh(force)
    UI.refreshing = true
    cachedEggs = evalEggs(force ~= false)
    task.wait()
    applyOpts(buildOpts())
    if #cachedEggs > 0 and not selectedEggUid then
        selectedEggUid = cachedEggs[1].uid
    end
    showSel()
    UI.refreshing = false
    return cachedEggs
end

MainTab:CreateButton({
