            steal.pend, steal.name, steal.pick = false, nil, false
        end)
    end
    function RedBeePickPrompt(m)
        if steal.pend then steal.pick = true return end
        if os.clock() - steal.lastAt < 8 then return end
        q[#q+1] = tostring(m)
    end
    local lastNote = {}
    function RedBeeNote(key, m, cd)
        local now = os.clock()
        key = tostring(key)
        if lastNote[key] and now - lastNote[key] < (cd or 60) then return end
        lastNote[key] = now
        for i = #q, 1, -1 do
            if type(q[i]) == "table" and q[i].key == key then table.remove(q, i) end
        end
        q[#q+1] = { key = key, text = tostring(m) }
    end
    task.spawn(function()
        local lastT, lastAt = nil, -100
        while true do
            if ((getgenv and getgenv().__RBG) or _G.__RBG) ~= GEN then return end
