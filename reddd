local function solidY(pos)
    local pp = RaycastParams.new()
    pp.FilterType = Enum.RaycastFilterType.Exclude
    local ig = {}
    local ch = getChar() if ch then ig[1] = ch end
    pp.FilterDescendantsInstances = ig
    pp.IgnoreWater = true
    local o = pos + Vector3.new(0, 80, 0)
    for _ = 1, 15 do
        local r = workspace:Raycast(o, Vector3.new(0, -700, 0), pp)
        if not r then return nil end
        if r.Instance.CanCollide then return r.Position.Y + K.GROUND_OFFSET end
        table.insert(ig, r.Instance)
        pp.FilterDescendantsInstances = ig
    end
    return nil
end

local function enableNC()
    if noclipConn then return end
    local cached, cur = nil, nil
    noclipConn = R.Stepped:Connect(function()
        local ch = getChar() if not ch then return end
        if cur ~= ch or not cached then
            cached, cur = {}, ch
            for _, p in ipairs(ch:GetDescendants()) do
                if p:IsA("BasePart") then cached[#cached+1] = p end
            end
        end
        for i = 1, #cached do
            local p = cached[i]
            if p.Parent and p.CanCollide then p.CanCollide = false end
        end
    end)
    RedBeeTop.noclip = noclipConn
end

local function disableNC()
    if noclipConn then pcall(function() noclipConn:Disconnect() end) noclipConn = nil end
end

function BX.arc(pos, speed, cancel)
    local ch, h = getChar(), getHRP()
    if not ch or not h or not pos then return end
    local hm = getHum()
    pcall(BX.claimOwner)
    speed = math.max(speed or K.ARC_SPEED, 40)
    local start = h.Position
    local ft = Vector3.new(pos.X - start.X, 0, pos.Z - start.Z).Magnitude
    if ft < 1 then return end
    local sg = solidY(start) or start.Y
    local eg = solidY(pos) or pos.Y
    local cy = math.max(sg, eg, start.Y, pos.Y) + K.ARC_CRUISE_UP
    local ramp = math.clamp(ft * K.ARC_RAMP_FRAC, K.ARC_RAMP_MIN, K.ARC_RAMP_MAX)
    local wasPS = hm and hm.PlatformStand or false
    if hm then hm.PlatformStand = true end
    local dl = os.clock() + math.max(ft / speed, .3) * 3 + 6
    local lastT = os.clock()
    local debt = 0
    while os.clock() < dl do
        if cancel and cancel() then break end
        local hh = getHRP() if not hh then break end
        local now = os.clock()
        local raw = now - lastT
        lastT = now
        debt = math.min((debt or 0) + raw, K.ARC_MAX_DEBT)
        local fd = math.min(debt, K.ARC_MAX_FRAME)
        debt = debt - fd
        local sub = math.max(1, math.ceil(fd / K.ARC_MAX_DT))
        local dt = fd / sub
        local flat = Vector3.new(pos.X - hh.Position.X, 0, pos.Z - hh.Position.Z)
        local rem = flat.Magnitude
        if rem <= K.ARC_ARRIVE then break end
        local dn = math.max(ft - rem, 0)
        local wy
        if dn < ramp then wy = start.Y + (cy - start.Y) * (dn / ramp)
        elseif rem < ramp then wy = eg + (cy - eg) * (rem / ramp)
        else wy = cy end
        for _ = 1, sub do
            local hp = hh.Position
            local f2 = Vector3.new(pos.X - hp.X, 0, pos.Z - hp.Z)
            local r2 = f2.Magnitude
            if r2 <= K.ARC_ARRIVE then break end
            local step = math.min(r2, speed * dt, K.ARC_MAX_STEP)
            local nx = hp + f2.Unit * step
            local dest = Vector3.new(nx.X, wy, nx.Z)
            pcall(function()
                if hm then hm:Move(Vector3.zero, false) end
                ch:PivotTo(CFrame.lookAt(dest, dest + f2.Unit))
                hh.AssemblyLinearVelocity = Vector3.zero
                hh.AssemblyAngularVelocity = Vector3.zero
            end)
        end
        R.Heartbeat:Wait()
    end
    if hm then hm.PlatformStand = wasPS end
    local hz = getHRP()
    if hz then hz.AssemblyLinearVelocity = Vector3.zero end
end

