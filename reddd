local rigBlockConn = nil

local function acOff()
    pcall(function()
        local ps = LP:FindFirstChild("PlayerScripts") if not ps then return end
        for _, nm in ipairs({ "AntiCollision", "AntiCollisionClient",
            "ObbyAntiTPClient", "AntiTP", "TeleportGuard" }) do
            local s = ps:FindFirstChild(nm, true)
            if s and s:IsA("BaseScript") and not s.Disabled then
                s.Disabled = true
                trace("ac: disabled " .. s.Name)
            end
        end
    end)
    pcall(function()
        local Rem = require(RS.Shared.Remotes)
        if Rem.RigSync and Rem.RigSync.Refresh and not rigBlockConn then
            rigBlockConn = Rem.RigSync.Refresh.OnClientEvent:Connect(function(raw)
                if tostring(raw):find("Relocate") then
                    local h = getHRP()
                    if h and BX.lastGoodPos then
                        pcall(function()
                            h.CFrame = CFrame.new(BX.lastGoodPos) * h.CFrame.Rotation
                            h.AssemblyLinearVelocity = Vector3.zero
                        end)
                    end
                end
            end)
            RedBeeTop.rigBlock = rigBlockConn
        end
    end)
    pcall(function()
        local Rem = require(RS.Shared.Remotes)
        local gp = Rem and Rem.GuardPatrol
        if not gp or type(hookfunction) ~= "function" then return end
        for _, nm in ipairs({ "Hit", "Catch", "Report" }) do
            local r = gp[nm]
            if r and type(r.FireServer) == "function" then
                local orig = r.FireServer
                pcall(hookfunction, r.FireServer, function(self, ...)
                    if heldEggUid then return end
                    return orig(self, ...)
                end)
            end
        end
    end)
    pcall(function()
        if OwnerDropRE and type(hookfunction) == "function" and not ownerHooked then
            local orig = OwnerDropRE.FireServer
            OwnerDropRE.FireServer = function(self, ...)
                if heldEggUid then return end
                return orig(self, ...)
            end
            ownerHooked = true
            trace("ac: hooked OwnerDropped")
        end
    end)
    if FieldCarryRE and not fieldHooked and type(hookfunction) == "function" then
        pcall(function()
            local orig = FieldCarryRE.FireServer
            FieldCarryRE.FireServer = function(self, ...)
                BX.lastCarryFire = os.clock()
                return orig(self, ...)
            end
            fieldHooked = true
            trace("ac: hooked FieldEggCarry")
        end)
    end
    trace("ac: bypass armed")
end

